# Build outputs
/bin/
/build/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test binaries and debugging artifacts
*.test
__debug_bin*

# Coverage and profiling output
coverage.out
coverage.html
coverage.xml
*.coverprofile
*.prof
*.pprof
cpu.out
mem.out

# Local Go workspace files
go.work
go.work.sum

# Local configuration and secrets
.env
.env.*
!.env.example

# Avoid tracking user-specific files
*.user
*.suo

# Ignore Visual Studio Code workspace settings
.vscode/
.vscode/*
.vs/
.vs/*
.idea/
.idea/*

# Ignore logs, database, and temporary files
/tmp/
/temp/
*.log
*.sql
*.sqlite
*.pdb

# Ignore user-specific temporary files
~$*
*.tmp
*.bak

# Ignore macOS and Linux system files
.DS_Store
*.swp
Thumbs.db
Desktop.ini

# Custom Rules
/cmd/pokeralgo-compute/*.preflop
